# API (build-time)
# VITE_API_URL=https://api.riseup.kids/api

# Schools page — WhatsApp CTA (digits with country code, e.g. 5511987654321)
VITE_SCHOOLS_WHATSAPP_NUMBER=

# Meta (Facebook) Pixel ID for marketing analytics. Public value (appears in page
# source). The Pixel only loads after the visitor accepts the cookie banner.
# Leave unset to disable Meta tracking entirely.
VITE_META_PIXEL_ID=

# reCAPTCHA v3 site key (bot protection on the invitation and school-application forms). Public
# value (appears in page source, same as the Pixel ID above) — get it from
# https://www.google.com/recaptcha/admin. The matching secret key is server-side only, see
# backend/.env.example's RECAPTCHA_SECRET_KEY.
VITE_RECAPTCHA_SITE_KEY=

# Parent sales page release mode: prelaunch (CTAs scroll to invitation) | launch (checkout)
# VITE_SALES_PAGE_MODE=prelaunch
# VITE_SALES_PAGE_MODE=launch

# Optional Flodesk URLs (for future use if CTAs link out again)
# VITE_PRELAUNCH_WAITLIST_URL=https://riseupkids.myflodesk.com/riseupkidsform?...
# VITE_PRELAUNCH_WAITLIST_URL_PT=...
# VITE_PRELAUNCH_WAITLIST_URL_ES=...
# VITE_PRELAUNCH_WAITLIST_URL_EN=...
